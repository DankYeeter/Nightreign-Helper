{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/enforce-data-redirect.ps1\"",
            "shell": "powershell",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
